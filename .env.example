# ─── Core ────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ─── Database ────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://repoinsight:repoinsight@db:5432/repoinsight
DATABASE_URL_SYNC=postgresql://repoinsight:repoinsight@db:5432/repoinsight
POSTGRES_USER=repoinsight
POSTGRES_PASSWORD=repoinsight
POSTGRES_DB=repoinsight

# ─── Redis ───────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Auth ────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── GitHub OAuth ────────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ─── AI providers ────────────────────────────────────
# Tried in this order; if one fails or hits its free daily limit, the next
# one answers. Only providers with a key set are used.
AI_PROVIDER_ORDER=gemini,groq,claude,openai

# Google Gemini — FREE tier, no credit card.
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Groq — FREE tier, no credit card. Used as the fallback.
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# Optional, PAID: Anthropic and OpenAI API usage is billed separately from
# any Claude.ai or ChatGPT subscription. Leave as not-set to stay at $0.
ANTHROPIC_API_KEY=not-set
OPENAI_API_KEY=not-set

# Embeddings run locally (sentence-transformers) — no key, no cost.

# ─── ChromaDB ────────────────────────────────────────
CHROMA_HOST=chroma
CHROMA_PORT=8000

# ─── Frontend ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Rate Limiting ───────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ─── Encryption key for sensitive tokens at rest ─────
# REQUIRED in production. Generate with: openssl rand -base64 32
# Without it, GitHub OAuth tokens would sit plaintext in the DB. The
# production-safety check refuses to boot without this set.
ENCRYPTION_KEY=

# Old keys, comma-separated, accepted for decryption only.
# Use this to rotate the primary key without breaking existing tokens.
ENCRYPTION_KEY_ROTATION=

# ─── Trusted reverse proxies ─────────────────────────
# Comma-separated IPs/CIDRs allowed to set X-Forwarded-For. Empty = trust no one.
# Examples: "127.0.0.1" (nginx on same host), "10.0.0.0/8" (private VPC).
# Without this, an attacker can rotate XFF values to bypass rate limits.
TRUSTED_PROXIES=
