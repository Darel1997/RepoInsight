# Production image for the Next.js frontend.
# Builds an optimized bundle once, then serves it with `next start`
# (the dev Dockerfile runs `next dev`, which is slow and not meant for the internet).

FROM node:20-alpine AS build
WORKDIR /app

COPY . .
# `npm ci` wipes any node_modules that came along with the source (e.g. from
# a Windows machine) and installs the exact versions from the lockfile.
RUN rm -rf .next && npm ci

# NEXT_PUBLIC_* values are baked into the bundle at build time, so the
# public URL has to be known here.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_TELEMETRY_DISABLED=1

RUN npm run build && npm prune --omit=dev

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1

COPY --from=build --chown=node:node /app/package.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/.next ./.next
COPY --from=build --chown=node:node /app/public ./public
COPY --from=build --chown=node:node /app/next.config.js ./

USER node
EXPOSE 3000
CMD ["npx", "next", "start", "-p", "3000"]
